{
  "name": "skyrim-dynamic-music",
  "version": "2.0.0",
  "description": "Trilha sonora dinâmica de Skyrim para Minecraft Bedrock (Script API estável).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.2"
  },
  "scripts": {
    "test": "node --import ./tests/support/register.mjs --test \"tests/*.test.js\"",
    "typecheck": "tsc -p jsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node tools/build.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@minecraft/server": "2.10.0",
    "@minecraft/server-ui": "2.2.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0"
  }
}
